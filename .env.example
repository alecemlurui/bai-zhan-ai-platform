# 数据库
DATABASE_URL=sqlite://db.sqlite3

# Redis（Celery 用）
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXP_SECONDS=3600

# LLM API（Coze / OpenAI 兼容）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0
# 费用估算（USD / 1M tokens），设为 0 则不计算
LLM_INPUT_PRICE_PER_1M=0.5
LLM_OUTPUT_PRICE_PER_1M=1.5

# 阿里云 OSS（可选，未配置则回退本地存储）
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=bai-zhan-platform

# 小红书发布（可选，未配置则 mock）
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=
XIAOHONGSHU_MOCK=true

# RAG / 向量库 / Embedding（可选，默认 mock）
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./chroma_db
# VECTOR_DB_URL=
# VECTOR_DB_API_KEY=
# 本地 ONNX 模型路径示例（相对项目根或绝对路径）
# EMBEDDING_MODEL_PATH=D:/ai agent学习/rag/models/Xenova--bge-small-zh-v1.5
# EMBEDDING_TOKENIZER_PATH=D:/ai agent学习/rag/models/Xenova--bge-small-zh-v1.5/tokenizer.json
EMBEDDING_MOCK=true
EMBEDDING_VECTOR_SIZE=512
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# 环境
ENVIRONMENT=development
LOG_LEVEL=INFO
